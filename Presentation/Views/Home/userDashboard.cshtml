@{
    ViewData["Title"] = "User Dashboard";
}

<!-- Navigation Bar -->
<div class="nav-bar">
    <a href="#">Home</a>
    <a href="#">Payees</a>
    <a href="#" id="logoutBtn">Log out</a>
</div>

<div class="container">
    <!-- Greeting -->
    <div class="title">
        Hi, <span id="userName">No name yet</span>!
    </div>

    <!-- Account Name & Action Buttons -->
    <div class="section">
        <div class="section-header">
            <div>
                <strong>Account Name:</strong> <span id="accountName">'the entered username'</span>
            </div>
            <div class="button-group">
                <button class="btn-main" id="makeTransactionBtn">Make a Transaction</button>
                <button class="btn-main" id="makeTransferBtn">Make a Transfer</button>
            </div>
        </div>
    </div>

    <!-- Bank Accounts -->
    <div class="section">
        <h3>Bank Accounts:</h3>
        <ul>
            <li>• Chequing - <span id="chequingBalance">$0.00</span></li>
            <li>• Savings - <span id="savingsBalance">$0.00</span></li>
        </ul>
        <button class="btn-sub" id="makeNewAccountBtn">Make new account</button>
    </div>

    <!-- Recent Transactions -->
    <div class="section">
        <h3>Recent Transactions:</h3>
        <table>
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Description</th>
                    <th>Amount</th>
                </tr>
            </thead>
            <tbody id="transactionTableBody">
                <tr>
                    <td colspan="3" style="text-align: center; padding: 20px; color: #999;">
                        No transactions yet
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/js/userDashboard.js"></script>
}