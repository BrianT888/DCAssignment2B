@{
    ViewData["Title"] = "Edit User Profile";
}

<div class="container">

    <div class="profile-card">
        <h3>Edit User Profile</h3>
        <img id="profilePic" src="" alt="Profile Picture" class="profile-pic">
        <ul>
            <li><strong>Name:</strong> <span id="profileName"></span></li>
            <li><strong>Email:</strong> <span id="profileEmail"></span></li>
            <li><strong>Phone:</strong> <span id="profilePhoneNumber"></span></li>
            <li><strong>Address:</strong> <span id="profileAddress"></span></li>
            <li><strong>Password:</strong> <span id="profilePassword">********</span></li>
        </ul>
        <button class="btn-main" id="backBtn">Back to User Management</button>
    </div>


    <div class="update-section">
        <h3>Update Info</h3>

        <div>
            <label for="newName">New Name:</label>
            <input type="text" id="newName" />
            <button class="btn-main" id="updateNameBtn">Update Name</button>
            <small id="nameError" style="color: red; display: block; margin-top: 4px;"></small>
        </div>

        <div>
            <label for="newEmail">New Email:</label>
            <input type="text" id="newEmail" />
            <button class="btn-main" id="updateEmailBtn">Update Email</button>
            <small id="emailError" style="color: red; display: block; margin-top: 4px;"></small>
        </div>

        <div>
            <label for="newPhone">New Phone:</label>
            <input type="text" id="newPhone" />
            <button class="btn-main" id="updatePhoneBtn">Update Phone</button>
            <small id="phoneError" style="color: red; display: block; margin-top: 4px;"></small>
        </div>

        <div>
            <label for="newAddress">New Address:</label>
            <input type="text" id="newAddress" />
            <button class="btn-main" id="updateAddressBtn">Update Address</button>
            <small id="addressError" style="color: red; display: block; margin-top: 4px;"></small>
        </div>

        <div>
            <label for="newPassword">New Password:</label>
            <input type="password" id="newPassword" placeholder="Enter new password">
            <button class="btn-main" id="updatePasswordBtn">Update Password</button>
            <small id="passwordError" style="color: red; display: block; margin-top: 4px;"></small>
        </div>
    </div>
</div>

<style>

    .container {
        background-color: white;
    }
    .profile-card {
        background-color: white;
        max-width: 400px;
        margin: 30px auto;
        padding: 20px;
        border: 1px solid #ccc;
        border-radius: 6px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.1);
        text-align: center;
    }

    .profile-pic {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        margin-bottom: 20px;
        object-fit: cover;
    }

    .profile-card ul {
        list-style: none;
        padding: 0;
        text-align: left;
    }

    .profile-card li {
        margin-bottom: 10px;
    }

    #backBtn {
        margin-top: 15px;
    }

    .update-section {
        background-color: white;
        max-width: 400px;
        margin: 30px auto;
        padding: 20px;
        border: 1px solid #ccc;
        border-radius: 6px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.1);
        text-align: center;
    }

    .update-section label {
        display: block;
        margin-top: 10px;
    }

    .update-section input {
        width: 100%;
        padding: 5px;
        margin-bottom: 5px;
    }

    .update-section button {
        margin-bottom: 10px;
    }
</style>

@section Scripts {
    <script src="~/js/editUser.js"></script>
}
